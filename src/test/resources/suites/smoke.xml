<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="iOS Smoke Suite" parallel="methods" thread-count="1" verbose="2">
    <test name="Smoke Tests">
        <classes>
            <class name="com.automation.tests.HomeTest">
                <methods>
                    <include name="verifyHomeScreenLoads"/>
                </methods>
            </class>
            <class name="com.automation.tests.SettingsTest">
                <methods>
                    <include name="verifySettingsPageLoads"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
